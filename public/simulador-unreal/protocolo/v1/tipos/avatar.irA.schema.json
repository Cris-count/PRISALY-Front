{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisaly.local/protocolo/v1/tipos/avatar.irA.schema.json",
  "title": "avatar.irA",
  "description": "Mueve el avatar a una zona (alternativa accesible).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    }
  }
}