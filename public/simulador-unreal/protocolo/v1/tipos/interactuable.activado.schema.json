{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisaly.local/protocolo/v1/tipos/interactuable.activado.schema.json",
  "title": "interactuable.activado",
  "description": "El estudiante activo un interactuable. Unreal no decide nada mas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interactuableId",
    "categoria"
  ],
  "properties": {
    "interactuableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "puerta",
        "npc",
        "documento",
        "cierre"
      ]
    }
  }
}