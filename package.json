{
  "name": "prisaly-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "pwsh.exe -NoProfile -File scripts/start-local.ps1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "check:urls": "node scripts/verificar-urls-api.mjs",
    "memory:visualize": "node ../.opencode/memory/visual/server.mjs",
    "memory:visualize:open": "node ../.opencode/memory/visual/server.mjs --open",
    "memory:export:json": "node ../.opencode/memory/visual/tools/export-json.mjs",
    "memory:export:svg": "node ../.opencode/memory/visual/tools/export-svg.mjs",
    "memory:export:graphml": "node ../.opencode/memory/visual/tools/export-graphml.mjs",
    "memory:preview": "node ../.opencode/memory/visual/tools/preview-json.mjs",
    "memory:visual-preview": "node ../.opencode/memory/visual/tools/preview-json.mjs",
    "start:angular": "ng serve",
    "start:backend": "pwsh.exe -NoProfile -File scripts/start-local.ps1 -Mode backend",
    "start:simulator": "pwsh.exe -NoProfile -File scripts/start-local.ps1 -Mode simulator",
    "stop": "pwsh.exe -NoProfile -File scripts/start-local.ps1 -Mode stop",
    "status": "pwsh.exe -NoProfile -File scripts/start-local.ps1 -Mode status",
    "up": "npm start",
    "down": "npm run stop",
    "check": "pwsh.exe -NoProfile -File scripts/start-local.ps1 -Mode check"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@epicgames-ps/lib-pixelstreamingfrontend-ue5.8": "0.1.4",
    "animejs": "^4.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@types/jasmine": "~6.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
