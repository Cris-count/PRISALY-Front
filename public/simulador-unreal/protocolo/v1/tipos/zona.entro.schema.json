{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisaly.local/protocolo/v1/tipos/zona.entro.schema.json",
  "title": "zona.entro",
  "description": "El avatar entro a un volumen de zona.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    }
  }
}