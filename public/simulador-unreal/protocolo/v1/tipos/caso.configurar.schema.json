{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prisaly.local/protocolo/v1/tipos/caso.configurar.schema.json",
  "title": "caso.configurar",
  "description": "ESTADO: PROPUESTO v2 (CB-04, corregido segun DC-CB-03 §7). Aplica la configuracion visual de un contexto visual: edificios habilitados y NPC activos. Solo ids visuales del catalogo; nunca textos, nombres narrativos, ids academicos, credenciales ni datos de evaluacion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idContextoVisual",
    "versionCatalogo",
    "hashCatalogo",
    "huella",
    "edificiosHabilitados",
    "npcsActivos"
  ],
  "properties": {
    "idContextoVisual": {
      "type": "string",
      "pattern": "^cv-[0-9a-f]{32}$"
    },
    "versionCatalogo": {
      "type": "string",
      "pattern": "^catalogo-visual-[1-9][0-9]{0,3}$"
    },
    "hashCatalogo": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "huella": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "edificiosHabilitados": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{1,63}$"
      }
    },
    "npcsActivos": {
      "type": "array",
      "minItems": 0,
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      }
    }
  }
}